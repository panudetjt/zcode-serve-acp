{
  "name": "zcode-serve-acp",
  "version": "0.4.3",
  "description": "Standalone Agent Client Protocol (ACP) bridge that attaches a coding-agent client (e.g. T3 Code Local ACP command) to the `zcode serve` daemon — the daemon owns ZCode credentials; the bridge never reads the credential store.",
  "license": "MIT",
  "bin": {
    "zcode-serve-acp": "./src/bin.ts"
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "test": "bun test ./test",
    "test:coverage": "bun test --coverage ./test",
    "check": "bun check",
    "compile": "bun build --compile --target=bun-linux-x64 --outfile \"${OUTFILE:-dist/zcode-serve-acp}\" src/bin.ts",
    "smoke": "bun scripts/smoke.mjs"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.1.4",
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.70.0",
    "bun-types": "^1.4.5",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
