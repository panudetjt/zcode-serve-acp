{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "[ -d .repos/effect/.git ] || { rm -rf .repos/effect; mkdir -p .repos && git clone --depth 1 https://github.com/Effect-TS/effect.git .repos/effect; }",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Setup Worktree (t3code vendor)",
      "command": "[ -d .repos/t3code/.git ] || { rm -rf .repos/t3code; mkdir -p .repos && git clone --depth 1 https://github.com/pingdotgg/t3code.git .repos/t3code; }",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Setup Worktree (zcode vendor)",
      "command": "[ -d .repos/zcode/.git ] || { rm -rf .repos/zcode; mkdir -p .repos && git clone --depth 1 https://github.com/zai-org/ZCode.git .repos/zcode; }",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    }
  ]
}
